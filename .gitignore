

# Claude Config Manager Extension - Security Rules
# Prevents accidental commit of private conversation data
.claude/.chats/
.claude/.chats/**
.claude/settings.local.json

# Team-sharable Claude Code files (tracked by git):
# .claude/settings.json     # Team settings (official Claude Code)
# .claude/commands/         # Team slash commands (official Claude Code)
# .claude/.plans/           # Project documentation (extension-specific)

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secretos (GEMINI_API_KEY para TutorAgent, etc.)
.env
.env.*

# ChromaDB persistente (índice del TutorAgent, se regenera localmente)
.chroma/

# Memoria episódica local del TutorAgent (se regenera por alumno/máquina)
.tutor_memory.json

# Material histórico del curso 2023-2024 (planeaciones, PSeInt, código previo).
# Se conserva localmente en docs/legado/ pero no se publica en GitHub.
docs/legado/

# Worktrees locales para trabajo aislado (sandboxes de desarrollo)
.worktrees/

# Artefactos internos del flujo de trabajo con Claude Code (specs, planes,
# reportes de auditoría, lockfiles). Se conservan localmente pero no se
# publican en el repo público — mismo patrón que docs/legado/.
docs/superpowers/
.claude/scheduled_tasks.lock
